# Copy to `.env` and fill in real values:  cp .env.example .env
#
# docker compose reads this file automatically. The same variable names are
# what the Spring services read, so they also work for a non-Docker run
# (export them in your shell or your IDE run configuration).
# `.env` is gitignored — never commit real secrets.

# ---- database --------------------------------------------------------------
# DB_PASSWORD is also the MySQL container's root password.
DB_NAME=banking_platform
DB_USERNAME=root
DB_PASSWORD=change-me

# ---- secrets ---------------------------------------------------------------
# Base64-encoded HMAC key shared by every service that validates a JWT.
# Generate one with:  openssl rand -base64 48
JWT_SECRET=change-me

# Shared secret for service-to-service calls (gateway -> notification WebSocket,
# transaction -> account). Generate one with:  openssl rand -hex 24
INTERNAL_SERVICE_KEY=change-me

# Spring Security's in-memory admin user on auth-service.
AUTH_ADMIN_USERNAME=admin
AUTH_ADMIN_PASSWORD=change-me

# ---- public URLs -----------------------------------------------------------
# Host-side URLs, not container names: the browser has to be able to reach them.
# WEBSOCKET_ALLOWED_ORIGINS guards against cross-site WebSocket hijacking, so it
# must list exactly the origins the client is served from.
WEBSOCKET_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
GATEWAY_PUBLIC_URL=http://localhost:8080

# ---- published host ports --------------------------------------------------
# Infrastructure defaults are off-by-one so they cannot clash with local
# MySQL/Redis/Kafka installs.
CLIENT_HOST_PORT=5173
GATEWAY_HOST_PORT=8080
MYSQL_HOST_PORT=3308
REDIS_HOST_PORT=6380
KAFKA_HOST_PORT=9094

# ---- kafka -----------------------------------------------------------------
# Any 22-character base64 UUID. Changing it after first start orphans the
# existing kafka-data volume.
KAFKA_CLUSTER_ID=5L6g3nShT-eMCtK--X86sw
